[Unit]
Description=SIPARTA Production IoT Edge Service (Raspberry Pi)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/SIPARTA/ai_models
# Ensure we use the virtual environment if it exists, otherwise use system python
ExecStart=/bin/bash -c "if [ -d '../iot_devices/venv' ]; then source ../iot_devices/venv/bin/activate && python3 main_rpi.py; else python3 main_rpi.py; fi"
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=siparta-iot

[Install]
WantedBy=multi-user.target
